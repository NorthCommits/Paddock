# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# From Neon: pooled address for the app, unpooled (direct) address for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

SECRET_KEY=change-me
APP_ORIGIN=http://localhost:3000
CONTENT_ORIGIN=http://localhost:8001

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
CONTENT_TOKEN_MINUTES=15

# Neon Auth handles sign up, sign in, email codes and password reset.
# Copy the Auth URL from the Neon console (Better Auth page). It is not a secret.
NEON_AUTH_URL=
# Set to true only if Neon is set to require a verified email before sign in.
NEON_AUTH_EMAIL_VERIFIED=false

# Email, used for page invitations. "console" prints emails in the backend log (development).
# Use "smtp" to send for real (required in production).
EMAIL_BACKEND=console
EMAIL_FROM=Paddock <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
