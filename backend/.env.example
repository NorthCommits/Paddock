# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# From Neon: pooled address for the app, unpooled (direct) address for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

SECRET_KEY=change-me
APP_ORIGIN=http://localhost:3000
CONTENT_ORIGIN=http://localhost:8001

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
CONTENT_TOKEN_MINUTES=15

# Email. "console" prints emails in the backend log (development).
# Use "smtp" to send for real (required in production).
EMAIL_BACKEND=console
EMAIL_FROM=Paddock <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
