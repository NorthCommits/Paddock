# Copy to .env.local and fill in. Never commit .env.local.
BACKEND_URL=http://localhost:8000
# The Auth URL from the Neon console (Better Auth page).
NEON_AUTH_BASE_URL=
# Any random string of at least 32 characters. Generate one with: openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET=

# The address people paste into Claude, ChatGPT, Claude Code or Codex (the API, not this site)
NEXT_PUBLIC_MCP_URL=http://localhost:8000/mcp
